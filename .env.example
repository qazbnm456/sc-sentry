# Copy this file to `.env` and fill it in. Git ignores `.env`, and it must stay that way. This file exists so that nobody has to guess the variable names from a traceback, and so that no real key has to be committed to name them.
#
# `rlm-harness` reads `RLM_MAIN_MODEL` and `RLM_SUB_MODEL` itself. That is right for this runner, because here the runner is the round and nothing else names the model. A harness submitted to a competition should not read them: there a round file announces the model, and with two sources of truth the environment silently wins.

RLM_MAIN_MODEL=
RLM_SUB_MODEL=
RLM_BASE_URL=
RLM_API_KEY=
RLM_ADAPTER=
# Per-call generation cap. Empty means 32768, and `--max-tokens` wins over it.
RLM_MAX_TOKENS=

# Optional. The runner pins temperature to 0.0 unless this is set, because unpinned means the server's default, typically 1.0, and two runs of one harness over one unit are then two samples of an unrecorded distribution.
# SC_SENTRY_TEMPERATURE=0.0
