# Copy to `.env` and fill in. `.env` is ignored by git and must stay that way:
# the only reason this file exists is so that nobody has to guess the variable
# names from a traceback, and so that no real key has to be committed to say so.
#
# `RLM_MAIN_MODEL` and `RLM_SUB_MODEL` are read by `rlm-harness` itself. That is
# correct here, where this runner IS the round and there is nothing for the
# environment to disagree with. A harness submitted to a competition should not
# read them: there a round file announces the model, and two sources of truth
# mean the environment silently winning.

RLM_MAIN_MODEL=
RLM_SUB_MODEL=
RLM_BASE_URL=
RLM_API_KEY=
RLM_ADAPTER=
# Per-call generation cap. Empty means 32768; `--max-tokens` wins over it.
RLM_MAX_TOKENS=

# Optional. Pinned to 0.0 by the runner unless set, because unpinned means the
# server's default -- typically 1.0 -- and two runs of one harness over one unit
# are then two samples of an unrecorded distribution.
# SC_SENTRY_TEMPERATURE=0.0
